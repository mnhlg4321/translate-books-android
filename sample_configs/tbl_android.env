# Translate Books with LLMs-only sample .env
LLM_PROVIDER=openrouter
BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
DEFAULT_MODEL=anthropic/claude-sonnet-4.6

DEFAULT_SOURCE_LANGUAGE=Japanese
DEFAULT_TARGET_LANGUAGE=Vietnamese
LANGUAGE_PROFILE=Japanese → Vietnamese Light Novel
OUTPUT_FILENAME_PATTERN={originalName} ({targetLang}).{ext}

# Android MVP dùng token estimator nhẹ, không phải tiktoken gốc.
CHUNK_MODE=token
MAX_TOKENS_PER_CHUNK=450
MAX_CHARS_PER_CHUNK=0
SOFT_LIMIT_RATIO=0.8
CONTEXT_CHARS=400

REQUEST_TIMEOUT=300
MAX_TRANSLATION_ATTEMPTS=3
TEMPERATURE=0.3
MAX_OUTPUT_TOKENS=4096
REFINE_AFTER_TRANSLATION=false
BILINGUAL_OUTPUT=false
ANDROID_SAVE_PARTIAL_OUTPUT=true

STOP_ON_COST_LIMIT=false
COST_LIMIT_USD=0
GLOSSARY_INJECT_LIMIT=80
PRONOUN_INJECT_LIMIT=40
